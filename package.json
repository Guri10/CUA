{
  "name": "cua",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discover how to drive a legacy web app with an LLM once, then replay it deterministically.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay": "tsx --env-file-if-exists=.env src/cli.ts replay",
    "discover": "tsx --env-file-if-exists=.env src/cli.ts discover",
    "serve": "tsx --env-file-if-exists=.env src/cli.ts serve",
    "catalog:demo": "tsx --env-file-if-exists=.env scripts/catalog-demo.ts",
    "test:e2e": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts",
    "capture:a11y": "tsx --env-file-if-exists=.env scripts/capture-accessibility-tree.ts",
    "capture:meridian": "tsx --env-file-if-exists=.env scripts/capture-meridian-members.ts",
    "capture:meridian-txn": "tsx --env-file-if-exists=.env scripts/capture-meridian-transactions.ts",
    "capture:meridian-account": "tsx --env-file-if-exists=.env scripts/capture-meridian-account.ts",
    "capture:meridian-recoverable": "tsx --env-file-if-exists=.env scripts/capture-meridian-recoverable.ts",
    "capability:write": "tsx scripts/write-capabilities.ts",
    "parabank:start": "docker run -d -p 8080:8080 --name parabank parasoft/parabank",
    "parabank:stop": "docker rm -f parabank",
    "replay:stability": "tsx --env-file-if-exists=.env scripts/replay-stability.ts",
    "evidence:recoverable": "tsx --env-file-if-exists=.env scripts/evidence-recoverable.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.119.0",
    "playwright": "^1.49.1",
    "zod": "^4.4.3"
  }
}
