# Copy to .env and fill in. .env is gitignored; this file is tracked so the
# README can document what config is needed without leaking values.

# --- Model -------------------------------------------------------------------
# Used only by the discovery path. Replay never calls a model.
ANTHROPIC_API_KEY=

# The chatbot's own key, used only by `npm run chat` to map a request to catalog
# invocation(s). Kept separate from the discovery key on purpose (#28): the
# chatbot is an external caller of the catalog, not part of the core. Never
# defaulted — `npm run chat` fails loudly if it is unset.
CHATBOT_API_KEY=

# --- Target application ------------------------------------------------------
# ParaBank, self-hosted per ADR 0003. Started with:
#   docker run -d -p 8080:8080 --name parabank parasoft/parabank
PARABANK_BASE_URL=http://localhost:8080/parabank

# Credentials for the demo bank's seeded user. ADR 0006 classes the application
# password a Secret, so no value for it is committed anywhere in this repo and
# nothing defaults it — the capture script fails if it is unset. README names
# the user the container seeds.
PARABANK_USERNAME=
PARABANK_PASSWORD=

# --- MERIDIAN Core -----------------------------------------------------------
# The legacy target for the MERIDIAN adaptation (#18). The base URL lives in the
# checked-in Surface profile (surfaces/meridian.json), so it is not repeated
# here; set MERIDIAN_BASE_URL only to point capture at a different installation.
#
# These credentials are needed only for capturing accessibility trees and the
# live e2e run — Replay against the FakeSurface uses none of them. ADR 0006
# classes the operator password a Secret: no value is committed and nothing
# defaults it, so capture fails if it is unset. The operator id and branch are
# non-secret.
MERIDIAN_OPERATOR=
MERIDIAN_PASSWORD=
# The branch exactly as the sign-on combobox lists it, e.g.
# "MAIN-001 - Main Office".
MERIDIAN_BRANCH=
# MERIDIAN_BASE_URL=https://web-sample.interface-hiring.com
#
# A supervisor operator, needed only to capture the place-hold success path:
# placing a hold is a RESTRICTED FUNCTION and a teller sign-on reaches the
# SUPERVISOR_OVERRIDE_REQUIRED (403) screen, not the confirmation. Same
# classification as above — the password is a Secret, never committed or
# defaulted; the operator id is non-secret. The branch is reused from
# MERIDIAN_BRANCH. Leave these empty to capture only the 403 path.
MERIDIAN_SUPERVISOR_OPERATOR=
MERIDIAN_SUPERVISOR_PASSWORD=
