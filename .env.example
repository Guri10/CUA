# Copy to .env and fill in. .env is gitignored; this file is tracked so the
# README can document what config is needed without leaking values.

# --- Model -------------------------------------------------------------------
# Used only by the discovery path. Replay never calls a model.
ANTHROPIC_API_KEY=

# --- Target application ------------------------------------------------------
# ParaBank, self-hosted per ADR 0003. Started with:
#   docker run -d -p 8080:8080 --name parabank parasoft/parabank
PARABANK_BASE_URL=http://localhost:8080/parabank

# Credentials for the demo bank's seeded user. ADR 0006 classes the application
# password a Secret, so no value for it is committed anywhere in this repo and
# nothing defaults it — the capture script fails if it is unset. README names
# the user the container seeds.
PARABANK_USERNAME=
PARABANK_PASSWORD=
