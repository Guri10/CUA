{
  "id": "meridian",
  "baseUrl": "https://web-sample.interface-hiring.com",
  "allowedOrigins": ["https://web-sample.interface-hiring.com"],
  "actions": ["navigate", "click", "fill", "select", "read", "waitFor"],
  "routes": {
    "read-only": [
      "/signon",
      "/menu",
      "/members",
      "/members/:id",
      "/settings",
      "/signoff"
    ],
    "mutating": [
      "/members/:id/transfer",
      "/members/:id/transfer/review",
      "/members/:id/transfer/post",
      "/members/:id/hold",
      "/members/:id/hold/review",
      "/members/:id/hold/post",
      "/members/:id/open-share",
      "/members/:id/open-share/review",
      "/members/:id/open-share/post",
      "/members/:id/update"
    ]
  },
  "recoverableConditions": [
    {
      "name": "SESSION_EXPIRED",
      "when": {
        "kind": "present",
        "locator": { "role": "heading", "name": { "kind": "literal", "value": "Session Ended" } }
      },
      "recover": "re-establish-session"
    },
    {
      "name": "MAINTENANCE",
      "when": {
        "kind": "present",
        "locator": { "role": "heading", "name": { "kind": "literal", "value": "System Maintenance" } }
      },
      "recover": "retry"
    }
  ]
}
