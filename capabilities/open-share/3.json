{
  "id": "open-share",
  "version": 3,
  "surface": "meridian",
  "approval": "draft",
  "contract": {
    "summary": "Open a new share for a member, walking form → review → post, and return the confirmation number and new share id.",
    "inputs": {
      "type": "object",
      "properties": {
        "memberNumber": {
          "type": "string"
        },
        "shareType": {
          "type": "string"
        },
        "initialDeposit": {
          "type": "string"
        }
      },
      "required": [
        "memberNumber",
        "shareType",
        "initialDeposit"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "properties": {
        "confirmationNumber": {
          "type": "string"
        },
        "newShareId": {
          "type": "string"
        }
      },
      "required": [
        "confirmationNumber",
        "newShareId"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "effects": "mutating",
    "terminalStates": [
      {
        "kind": "success",
        "when": {
          "kind": "all",
          "of": [
            {
              "kind": "present",
              "locator": {
                "role": "cell",
                "ordinal": 1,
                "within": {
                  "role": "row",
                  "name": {
                    "kind": "literal",
                    "value": "Confirmation:"
                  },
                  "ordinal": 1
                }
              }
            },
            {
              "kind": "present",
              "locator": {
                "role": "cell",
                "ordinal": 1,
                "within": {
                  "role": "row",
                  "name": {
                    "kind": "literal",
                    "value": "New Share ID:"
                  },
                  "ordinal": 1
                }
              }
            }
          ]
        }
      }
    ]
  },
  "recordings": [
    {
      "variant": "base",
      "steps": [
        {
          "id": "navigate-menu",
          "action": {
            "kind": "navigate",
            "url": {
              "kind": "literal",
              "value": "/menu"
            }
          }
        },
        {
          "id": "click-link-open-new-share",
          "action": {
            "kind": "click",
            "locator": {
              "role": "link",
              "name": {
                "kind": "literal",
                "value": "Open New Share"
              }
            }
          }
        },
        {
          "id": "fill-textbox",
          "action": {
            "kind": "fill",
            "locator": {
              "role": "textbox"
            },
            "value": {
              "kind": "input",
              "input": "memberNumber"
            }
          }
        },
        {
          "id": "click-button-search",
          "action": {
            "kind": "click",
            "locator": {
              "role": "button",
              "name": {
                "kind": "literal",
                "value": "Search"
              }
            }
          }
        },
        {
          "id": "click-link-select",
          "action": {
            "kind": "click",
            "locator": {
              "role": "link",
              "name": {
                "kind": "literal",
                "value": "Select"
              }
            }
          }
        },
        {
          "id": "click-combobox",
          "action": {
            "kind": "click",
            "locator": {
              "role": "combobox"
            }
          }
        },
        {
          "id": "select-combobox",
          "action": {
            "kind": "select",
            "locator": {
              "role": "combobox"
            },
            "option": {
              "kind": "input",
              "input": "shareType"
            }
          }
        },
        {
          "id": "click-combobox-2",
          "action": {
            "kind": "click",
            "locator": {
              "role": "combobox"
            }
          }
        },
        {
          "id": "click-textbox",
          "action": {
            "kind": "click",
            "locator": {
              "role": "textbox"
            }
          }
        },
        {
          "id": "fill-textbox-2",
          "action": {
            "kind": "fill",
            "locator": {
              "role": "textbox"
            },
            "value": {
              "kind": "input",
              "input": "initialDeposit"
            }
          }
        },
        {
          "id": "click-button-continue",
          "action": {
            "kind": "click",
            "locator": {
              "role": "button",
              "name": {
                "kind": "literal",
                "value": "Continue"
              },
              "exact": true
            }
          }
        },
        {
          "id": "click-button-open-share",
          "action": {
            "kind": "click",
            "locator": {
              "role": "button",
              "name": {
                "kind": "literal",
                "value": "Open Share"
              },
              "exact": true
            }
          }
        },
        {
          "id": "read-confirmation-number",
          "action": {
            "kind": "read",
            "locator": {
              "role": "cell",
              "ordinal": 1,
              "within": {
                "role": "row",
                "name": {
                  "kind": "literal",
                  "value": "Confirmation:"
                },
                "ordinal": 1
              }
            },
            "bind": "confirmationNumber"
          }
        },
        {
          "id": "read-new-share-id",
          "action": {
            "kind": "read",
            "locator": {
              "role": "cell",
              "ordinal": 1,
              "within": {
                "role": "row",
                "name": {
                  "kind": "literal",
                  "value": "New Share ID:"
                },
                "ordinal": 1
              }
            },
            "bind": "newShareId"
          }
        }
      ]
    }
  ]
}
