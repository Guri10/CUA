{
  "id": "funds-transfer",
  "version": 3,
  "surface": "meridian",
  "approval": "draft",
  "contract": {
    "summary": "Transfer an amount between two of a member's shares, walking form → review → post, and return the confirmation number.",
    "inputs": {
      "type": "object",
      "properties": {
        "memberNumber": {
          "type": "string"
        },
        "fromShare": {
          "type": "string"
        },
        "toShare": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        },
        "memo": {
          "type": "string"
        }
      },
      "required": [
        "memberNumber",
        "fromShare",
        "toShare",
        "amount",
        "memo"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "properties": {
        "confirmationNumber": {
          "type": "string"
        }
      },
      "required": [
        "confirmationNumber"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    },
    "effects": "mutating",
    "terminalStates": [
      {
        "kind": "success",
        "when": {
          "kind": "all",
          "of": [
            {
              "kind": "present",
              "locator": {
                "role": "cell",
                "ordinal": 1,
                "within": {
                  "role": "row",
                  "name": {
                    "kind": "literal",
                    "value": "Confirmation:"
                  },
                  "ordinal": 1
                }
              }
            }
          ]
        }
      }
    ]
  },
  "recordings": [
    {
      "variant": "base",
      "steps": [
        {
          "id": "navigate-menu",
          "action": {
            "kind": "navigate",
            "url": {
              "kind": "literal",
              "value": "/menu"
            }
          }
        },
        {
          "id": "click-link-funds-transfer",
          "action": {
            "kind": "click",
            "locator": {
              "role": "link",
              "name": {
                "kind": "literal",
                "value": "Funds Transfer"
              }
            }
          }
        },
        {
          "id": "fill-textbox",
          "action": {
            "kind": "fill",
            "locator": {
              "role": "textbox"
            },
            "value": {
              "kind": "input",
              "input": "memberNumber"
            }
          }
        },
        {
          "id": "click-button-search",
          "action": {
            "kind": "click",
            "locator": {
              "role": "button",
              "name": {
                "kind": "literal",
                "value": "Search"
              }
            }
          }
        },
        {
          "id": "click-link-select",
          "action": {
            "kind": "click",
            "locator": {
              "role": "link",
              "name": {
                "kind": "literal",
                "value": "Select"
              }
            }
          }
        },
        {
          "id": "click-combobox",
          "action": {
            "kind": "click",
            "locator": {
              "role": "combobox",
              "ordinal": 0
            }
          }
        },
        {
          "id": "select-combobox",
          "action": {
            "kind": "select",
            "locator": {
              "role": "combobox",
              "ordinal": 0
            },
            "option": {
              "kind": "input",
              "input": "fromShare"
            }
          }
        },
        {
          "id": "click-combobox-2",
          "action": {
            "kind": "click",
            "locator": {
              "role": "combobox",
              "ordinal": 0
            }
          }
        },
        {
          "id": "click-combobox-3",
          "action": {
            "kind": "click",
            "locator": {
              "role": "combobox",
              "ordinal": 1
            }
          }
        },
        {
          "id": "select-combobox-2",
          "action": {
            "kind": "select",
            "locator": {
              "role": "combobox",
              "ordinal": 1
            },
            "option": {
              "kind": "input",
              "input": "toShare"
            }
          }
        },
        {
          "id": "click-combobox-4",
          "action": {
            "kind": "click",
            "locator": {
              "role": "combobox",
              "ordinal": 1
            }
          }
        },
        {
          "id": "click-textbox",
          "action": {
            "kind": "click",
            "locator": {
              "role": "textbox",
              "ordinal": 0
            }
          }
        },
        {
          "id": "fill-textbox-2",
          "action": {
            "kind": "fill",
            "locator": {
              "role": "textbox",
              "ordinal": 0
            },
            "value": {
              "kind": "input",
              "input": "amount"
            }
          }
        },
        {
          "id": "click-textbox-2",
          "action": {
            "kind": "click",
            "locator": {
              "role": "textbox",
              "ordinal": 1
            }
          }
        },
        {
          "id": "fill-textbox-3",
          "action": {
            "kind": "fill",
            "locator": {
              "role": "textbox",
              "ordinal": 1
            },
            "value": {
              "kind": "input",
              "input": "memo"
            }
          }
        },
        {
          "id": "click-button-continue",
          "action": {
            "kind": "click",
            "locator": {
              "role": "button",
              "name": {
                "kind": "literal",
                "value": "Continue"
              },
              "exact": true
            }
          }
        },
        {
          "id": "click-button-post-transfer",
          "action": {
            "kind": "click",
            "locator": {
              "role": "button",
              "name": {
                "kind": "literal",
                "value": "Post Transfer"
              },
              "exact": true
            }
          }
        },
        {
          "id": "read-confirmation-number",
          "action": {
            "kind": "read",
            "locator": {
              "role": "cell",
              "ordinal": 1,
              "within": {
                "role": "row",
                "name": {
                  "kind": "literal",
                  "value": "Confirmation:"
                },
                "ordinal": 1
              }
            },
            "bind": "confirmationNumber"
          }
        }
      ]
    }
  ]
}
